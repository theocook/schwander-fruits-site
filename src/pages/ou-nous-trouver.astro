---
import Base from '../layouts/Base.astro'
import { site, pointsDeVente } from '../data/site.js'
---

<Base
  title="Où nous trouver"
  description="Vente à la ferme de Cheseaux-Noréaz et sur le marché d’Yverdon-les-Bains, mardi et samedi."
>
  <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-16">
    <h1 class="text-4xl font-semibold text-forest sm:text-5xl">Où nous trouver</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-ink/70">
      Deux points de vente, une seule récolte : celle du jour.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {pointsDeVente.map((pv) => (
        <section class="flex flex-col border border-forest/10 bg-white/70 p-6 sm:p-7">
          <h2 class="font-serif text-2xl font-semibold text-forest">{pv.nom}</h2>
          <p class="mt-1.5 text-sm text-ink/60">{pv.adresse}</p>
          <p class="mt-4 leading-relaxed text-ink/75">{pv.detail}</p>
          <dl class="mt-6 space-y-1 text-sm">
            {pv.horaires.map((h) => (
              <div class="flex justify-between gap-4 border-b border-forest/8 py-2">
                <dt class="text-ink/70">{h.jours}</dt>
                <dd class="font-medium tabular-nums text-forest">{h.heures}</dd>
              </div>
            ))}
          </dl>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(pv.adresse)}`}
            rel="noopener"
            class="mt-6 inline-block self-start border border-forest/20 px-5 py-2.5 text-sm font-semibold text-forest transition hover:bg-leaf"
          >
            Itinéraire →
          </a>
        </section>
      ))}
    </div>

    <div class="mt-10 border border-forest/10 bg-leaf/50 p-6 sm:p-7">
      <h2 class="font-serif text-lg font-semibold text-forest">Un doute sur la disponibilité ?</h2>
      <p class="mt-2 leading-relaxed text-ink/75">
        Un coup de fil avant de vous déplacer, c’est plus sûr — surtout en début et en fin de saison.
      </p>
      <a
        href={`tel:${site.telephone.replace(/\s/g, '')}`}
        class="mt-5 inline-block bg-forest px-6 py-3 text-sm font-semibold text-cream transition hover:bg-green"
      >
        {site.telephone}
      </a>
    </div>
  </div>
</Base>
