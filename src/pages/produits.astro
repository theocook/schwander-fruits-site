---
import Base from '../layouts/Base.astro'
import ProductRow from '../components/ProductRow.astro'
import { getCatalogue } from '../data/catalogue.js'
import { STATUSES } from '../data/products.js'

const { products, categories } = await getCatalogue()
const parCategorie = categories
  .map((c) => ({ ...c, items: products.filter((p) => p.category === c.id) }))
  .filter((c) => c.items.length > 0)
const compteurs = Object.fromEntries(
  STATUSES.map((s) => [s.id, products.filter((p) => p.status === s.id).length]),
)
---

<Base
  title="Nos produits"
  description="Le catalogue complet de la ferme Schwander et la disponibilité de chaque produit."
>
  <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
    <p class="surtitre text-green">Le catalogue</p>
    <h1 class="mt-3 text-4xl font-semibold text-forest sm:text-6xl">Nos produits</h1>
    <p class="mt-5 max-w-xl leading-relaxed text-ink/70">
      {products.length} produits cultivés ou préparés à la ferme. Le repère de couleur indique ce qui est
      disponible aujourd'hui.
    </p>

    <!-- Filtres. Sans JavaScript, tout reste affiché : rien n'est perdu. -->
    <div class="surtitre mt-10 flex flex-wrap gap-x-6 gap-y-3 border-y border-forest/12 py-4" data-filtres>
      <button
        type="button"
        data-statut="tous"
        aria-pressed="true"
        class="flex items-center gap-2 text-ink/45 transition aria-pressed:text-forest"
      >
        Tous <span class="tabular-nums opacity-55">{products.length}</span>
      </button>
      {STATUSES.filter((s) => compteurs[s.id] > 0).map((s) => (
        <button
          type="button"
          data-statut={s.id}
          aria-pressed="false"
          class="flex items-center gap-2 text-ink/45 transition aria-pressed:text-forest"
        >
          <span class="h-[7px] w-[7px] shrink-0" style={`background:${s.color}`} />
          {s.label}
          <span class="tabular-nums opacity-55" data-compte-statut>
            {compteurs[s.id]}
          </span>
        </button>
      ))}
    </div>

    {parCategorie.map((cat, i) => (
      <section class="mt-16 scroll-mt-24" id={cat.id} data-categorie>
        <div class="flex items-baseline gap-4 border-b-2 border-forest pb-3">
          <span class="surtitre tabular-nums text-green">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="font-serif text-2xl font-semibold text-forest sm:text-3xl">{cat.label}</h2>
          <span class="surtitre ml-auto text-ink/40" data-compte>
            {cat.items.length}
          </span>
        </div>
        <div class="mt-2">
          {cat.items.map((p) => (
            <div data-produit data-id={p.id} data-statut={p.status}>
              <ProductRow product={p} />
            </div>
          ))}
        </div>
        <p class="hidden py-6 text-sm text-ink/45" data-vide>
          Rien dans cette catégorie pour ce filtre.
        </p>
      </section>
    ))}
  </div>

  <script>
    import '../scripts/maj-statuts.js'

    const barre = document.querySelector('[data-filtres]')
    const boutons = () => [...barre.querySelectorAll('[data-statut]')]

    function appliquer() {
      const actif = barre.querySelector('[aria-pressed="true"]')
      const choix = actif ? actif.dataset.statut : 'tous'
      document.querySelectorAll('[data-produit]').forEach((el) => {
        el.hidden = choix !== 'tous' && el.dataset.statut !== choix
      })
      // Chaque catégorie recompte ses produits visibles et signale si elle se vide.
      document.querySelectorAll('[data-categorie]').forEach((sec) => {
        const visibles = [...sec.querySelectorAll('[data-produit]')].filter((el) => !el.hidden).length
        sec.querySelector('[data-compte]').textContent = String(visibles)
        sec.querySelector('[data-vide]').classList.toggle('hidden', visibles > 0)
      })
    }

    barre?.addEventListener('click', (e) => {
      const bouton = e.target.closest('[data-statut]')
      if (!bouton) return
      boutons().forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)))
      appliquer()
    })

    // Statuts frais reçus de Sanity : les compteurs de la barre et le filtre courant se recalculent.
    document.addEventListener('statuts:maj', () => {
      const nb = {}
      document.querySelectorAll('[data-produit]').forEach((el) => {
        nb[el.dataset.statut] = (nb[el.dataset.statut] ?? 0) + 1
      })
      boutons().forEach((b) => {
        const compte = b.querySelector('[data-compte-statut]')
        if (compte) compte.textContent = String(nb[b.dataset.statut] ?? 0)
      })
      appliquer()
    })
  </script>
</Base>
