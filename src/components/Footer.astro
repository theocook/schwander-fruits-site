---
import Logo from './Logo.astro'
import { site, pointsDeVente } from '../data/site.js'
const ferme = pointsDeVente[0]
---

<footer class="mt-24 border-t border-forest/10 bg-forest text-cream/85">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="bg-cream/95 p-1">
          <Logo size={36} />
        </span>
        <span class="font-serif text-lg font-semibold text-cream">Schwander</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-cream/70">{site.baseline}.</p>
      <p class="mt-3 inline-block bg-cream/10 px-3 py-1 text-xs font-medium">{site.label}</p>
    </div>

    <div>
      <h2 class="font-serif text-base text-cream">Nous rendre visite</h2>
      <p class="mt-3 text-sm text-cream/70">{ferme.adresse}</p>
      <dl class="mt-3 space-y-1 text-sm text-cream/70">
        {ferme.horaires.map((h) => (
          <div class="flex justify-between gap-4 border-b border-cream/10 py-1">
            <dt>{h.jours}</dt>
            <dd class="tabular-nums">{h.heures}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div>
      <h2 class="font-serif text-base text-cream">Nous contacter</h2>
      <ul class="mt-3 space-y-2 text-sm text-cream/70">
        <li>
          <a class="hover:text-cream" href={`tel:${site.telephone.replace(/\s/g, '')}`}>
            {site.telephone}
          </a>
        </li>
        <li>
          <a class="hover:text-cream" href={`tel:${site.mobile.replace(/\s/g, '')}`}>
            {site.mobile}
          </a>
        </li>
        <li>
          <a class="hover:text-cream" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </li>
        {site.facebook && (
          <li>
            <a class="hover:text-cream" href={site.facebook} rel="noopener">
              Facebook
            </a>
          </li>
        )}
      </ul>
    </div>
  </div>
  <div class="border-t border-cream/10 py-5 text-center text-xs text-cream/45">
    © {new Date().getFullYear()} Schwander Fruits — {site.lieu}
  </div>
</footer>
