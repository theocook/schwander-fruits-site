---
import StatusTag from './StatusTag.astro'
import { CATEGORIES } from '../data/products.js'

const { product, showCategory = false } = Astro.props
const horsSaison = product.status === 'pas-de-saison'
const categorie = CATEGORIES.find((c) => c.id === product.category)?.label
---

<!--
 Grille en 2 colonnes sur mobile (le statut passe sous le nom : il a toute la largeur),
 en 3 colonnes dès `sm` (le statut se cale à droite).
 `min-w-0` sur la colonne de texte : c'est ce qui empêche un nom long de déborder.
-->
<div
  class:list={[
    'group grid grid-cols-[64px_minmax(0,1fr)] items-center gap-x-4 gap-y-1 border-b border-forest/12 py-3',
    'sm:grid-cols-[76px_minmax(0,1fr)_auto] sm:gap-x-5 sm:py-3.5',
    horsSaison && 'opacity-45',
  ]}
>
  <div class="row-span-2 overflow-hidden sm:row-span-1">
    <img
      src={product.image}
      alt={product.name}
      width="688"
      height="688"
      loading="lazy"
      decoding="async"
      class="aspect-square h-16 w-16 object-cover transition-transform duration-500 group-hover:scale-105 sm:h-19 sm:w-19"
    />
  </div>

  <div class="min-w-0">
    <h3 class="font-serif text-[17px] leading-tight font-semibold text-balance text-forest sm:text-lg">
      {product.name}
    </h3>
    {showCategory && categorie && <p class="mt-0.5 text-[11px] tracking-wide text-ink/40">{categorie}</p>}
  </div>

  <div class="sm:justify-self-end">
    <StatusTag status={product.status} />
  </div>
</div>
