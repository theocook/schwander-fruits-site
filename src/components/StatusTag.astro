---
import { STATUS_STYLES, TAG_BASE, DOT_BASE } from '../lib/sanity.js'

const { status } = Astro.props
const s = STATUS_STYLES[status] ?? STATUS_STYLES['pas-de-saison']
---

<span data-tag class:list={[TAG_BASE, s.txt]}>
  <span data-dot class:list={[DOT_BASE, s.dot]}></span>
  <span data-label>{s.label}</span>
</span>
